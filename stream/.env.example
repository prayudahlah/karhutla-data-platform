# Contoh konfigurasi node stream (producer FIRMS ke Redpanda).
# Copy menjadi stream/.env, isi nilainya, lalu chmod 600.
# Berkas stream/.env diabaikan git; jangan pernah di-commit.
#
# Node batch dan core punya berkas sendiri: .env di root repo.

# ------------------------------------------------------------------ umum
TZ=Asia/Jakarta

# ---------------------------------------------------------------- FIRMS
# Wajib. Buat di https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Kunci ini berbeda dari akun Earthdata dan hanya berlaku untuk API FIRMS.
FIRMS_MAP_KEY=change_me

# ------------------------------------------------------------- Redpanda
# Broker internal node stream.
REDPANDA_BROKERS=stream:9092
REDPANDA_TOPIC=firms.hotspot.raw

# -------------------------------------------------------------- Telegram
# chat_id grup diawali -100. Kosongkan token dan chat_id untuk mematikan
# notifikasi; producer tetap berjalan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# message_thread_id tiap topik. Kosong berarti masuk ke General.
TELEGRAM_TOPIC_HOTSPOT=
TELEGRAM_TOPIC_PIPELINE=
TELEGRAM_TOPIC_DQ=
TELEGRAM_TOPIC_GENERAL=

# ------------------------------------------------------------------ data
# Spool WAL dan state dedup. Di dalam container compose nilainya /app/data.
DATA_DIR=/app/data
# Retensi state dan spool; cukup sepanjang lookback + margin.
SEEN_RETENTION_DAYS=7
SPOOL_RETENTION_DAYS=7

# ---------------------------------------------------------------- metrik
# Port metrik Prometheus. 0 mematikan exporter.
METRICS_PORT=9101

# ------------------------------------------------------- bawaan argumen CLI
# Hanya rujukan. Ubah lewat flag, bukan lewat env.
# --source VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# --bbox 95,-11,141,6
# --day-range 2
# --interval 600
# --min-conf nominal
# --min-frp 5
# --stale-hours 12
# --fail-alert-after 3
