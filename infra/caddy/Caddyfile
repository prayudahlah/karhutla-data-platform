# Reverse proxy untuk portal, API, dan Grafana.
#
# Semua akses lewat Authelia. Header identitas dari klien selalu ditimpa
# dengan nilai dari respons Authelia, supaya tidak bisa dipalsukan.
{
	admin off
	local_certs
}

{$SCHEME:http}://auth.{$BASE_DOMAIN:localhost} {
	reverse_proxy authelia:9091
}

{$SCHEME:http}://app.{$BASE_DOMAIN:localhost} {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy api:8000
}

{$SCHEME:http}://grafana.{$BASE_DOMAIN:localhost} {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy grafana:3000
}

{$SCHEME:http}://metabase.{$BASE_DOMAIN:localhost} {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy metabase:3000
}

{$SCHEME:http}://prefect.{$BASE_DOMAIN:localhost} {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy prefect-server:4200
}
