TZ=Asia/Jakarta

POSTGRES_HOST=core
POSTGRES_PORT=5432
POSTGRES_DB=karhutla
POSTGRES_USER=karhutla
POSTGRES_PASSWORD=change_me

MINIO_ENDPOINT=http://batch:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=lakehouse

# Garage Object Storage (S3-compatible) for the Bronze layer.
# For local docker run, the S3 API is exposed on http://127.0.0.1:3900.
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_ACCESS_KEY_ID=change_me
GARAGE_SECRET_ACCESS_KEY=change_me
GARAGE_BUCKET=lakehouse
GARAGE_FORCE_PATH_STYLE=true
BRONZE_PREFIX=bronze/open_meteo

REDPANDA_BROKERS=stream:9092
REDPANDA_TOPIC=firms.hotspot.raw

# Set only when a Prefect server is reachable. Leave empty/comment out for the
# local ephemeral Prefect API used by the manual Bronze ingestion flow.
PREFECT_API_URL=http://core:4200/api
MLFLOW_TRACKING_URI=http://batch:5000

FIRMS_MAP_KEY=change_me
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Open-Meteo Bronze ingestion.
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENMETEO_TIMEZONE=Asia/Jakarta
OPENMETEO_FORECAST_DAYS=3
OPENMETEO_PAST_DAYS=0
OPENMETEO_TIMEOUT_SECONDS=30
OPENMETEO_MAX_RETRIES=3
OPENMETEO_CITY_CSV=resources/indonesia_cities.csv

PORTAL_BASE_URL=http://core:8000
