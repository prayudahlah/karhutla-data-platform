# Contoh konfigurasi node batch dan core.
# Copy menjadi .env di root repo, lalu isi nilainya dan chmod 600.
# Berkas .env diabaikan git; jangan pernah di-commit.
#
# Node stream punya berkas sendiri: stream/.env (lihat stream/.env.example).

# ------------------------------------------------------------------ umum
TZ=Asia/Jakarta

# --------------------------------------------------------------- Garage
# Object storage S3-compatible untuk layer Bronze.
# Di lokal, S3 API terbuka di http://127.0.0.1:3900.
# Di dalam jaringan compose, pakai http://garage:3900.
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_ACCESS_KEY_ID=change_me
GARAGE_SECRET_ACCESS_KEY=change_me
GARAGE_BUCKET=lakehouse
GARAGE_FORCE_PATH_STYLE=true

# Kredensial default yang dibuat Garage saat start (--default-bucket).
# Access key berformat "GK" + 32 hex; secret key 64 hex.
GARAGE_DEFAULT_BUCKET=lakehouse
GARAGE_DEFAULT_ACCESS_KEY=change_me
GARAGE_DEFAULT_SECRET_KEY=change_me

# Admin API (port 3903). Dipakai garage-webui dan `garage status` remote.
GARAGE_ADMIN_TOKEN=change_me          # openssl rand -base64 32
GARAGE_METRICS_TOKEN=change_me        # openssl rand -base64 32

# Web UI (port 3909). Kosongkan untuk tanpa login; isi dengan
# "username:bcrypt-hash" untuk mengaktifkan auth. Setiap "$" di hash harus
# ditulis "$$" di docker compose.
GARAGE_WEBUI_AUTH=

# ------------------------------------------------------- prefix Bronze
# Prefix dasar per sumber. Kode menambahkan segmen dataset=<nama> di bawahnya,
# jadi jangan tulis dataset di sini. Aturan lengkap ada di
# docs/data-contracts/README.md.
BRONZE_PREFIX=bronze/open_meteo
BRONZE_PREFIX_FIRMS=bronze/firms
BRONZE_PREFIX_MCD64A1=bronze/mcd64a1

# --------------------------------------------------------------- MCD64A1
# Burned area dari LP DAAC. Token dari https://urs.earthdata.nasa.gov
# (menu User Tokens). Tanpa token, unduhan gagal dengan HTTP 401.
EARTHDATA_TOKEN=change_me
BURNED_AREA_BBOX=95,-11,141,6
BURNED_AREA_SHORT_NAME=MCD64A1
BURNED_AREA_VERSION=061
CMR_GRANULES_URL=https://cmr.earthdata.nasa.gov/search/granules.json
BURNED_AREA_TIMEOUT_SECONDS=60
BURNED_AREA_MAX_RETRIES=3

# ------------------------------------------------------------ Open-Meteo
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_TIMEZONE=Asia/Jakarta
OPENMETEO_FORECAST_DAYS=3
# 0 berarti hanya prakiraan. Isi 1 sampai 7 kalau fitur model butuh
# observasi beberapa hari terakhir.
OPENMETEO_PAST_DAYS=0
OPENMETEO_TIMEOUT_SECONDS=30
OPENMETEO_MAX_RETRIES=3
OPENMETEO_CITY_CSV=resources/indonesia_cities.csv
OPENMETEO_PROVINCES_CSV=resources/indonesia_provinces.csv
# province = satu titik per provinsi (ibu kota), 38 baris
# city     = 98 kota
OPENMETEO_LOCATION_LEVEL=province

# --------------------------------------------- Redpanda dan consumer
# Consumer berjalan di node batch dan membaca topik dari node stream.
REDPANDA_BROKERS=stream:9092
REDPANDA_TOPIC=firms.hotspot.raw
REDPANDA_DLQ_TOPIC=firms.hotspot.dlq
CONSUMER_GROUP=bronze-firms
CONSUMER_FLUSH_SECONDS=60
CONSUMER_MAX_EVENTS=5000
DLQ_ALERT_INTERVAL_SECONDS=1800

# garage = tulis ke Garage, local = tulis ke DATA_DIR/bronze/firms.
BRONZE_SINK=garage
DATA_DIR=/app/data
# Port metrik Prometheus consumer. 0 mematikan exporter.
METRICS_PORT=9102

# -------------------------------------------------------------- Telegram
# Dipakai consumer untuk alert DLQ. Producer memakai stream/.env sendiri.
# Kosongkan token dan chat_id untuk mematikan notifikasi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# message_thread_id tiap topik. Kosong berarti masuk ke General.
TELEGRAM_TOPIC_HOTSPOT=
TELEGRAM_TOPIC_PIPELINE=
TELEGRAM_TOPIC_DQ=
TELEGRAM_TOPIC_GENERAL=

# ------------------------------------------------------ Prefect dan ML
# Kosongkan PREFECT_API_URL untuk memakai API ephemeral saat menjalankan
# flow manual. Isi kalau server Prefect sudah berjalan.
PREFECT_API_URL=http://core:4200/api
MLFLOW_TRACKING_URI=http://batch:5000
PORTAL_BASE_URL=http://core:8000

# -------------------------------------------------------------- Postgres
# Belum dipakai service mana pun; disiapkan untuk tahap serving.
POSTGRES_HOST=core
POSTGRES_PORT=5432
POSTGRES_DB=karhutla
POSTGRES_USER=karhutla
POSTGRES_PASSWORD=change_me
