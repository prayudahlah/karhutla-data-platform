FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

COPY src /app/src

RUN pip install --no-cache-dir \
    "duckdb>=1.1" \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.30"

EXPOSE 8000

CMD ["uvicorn", "serving.main:app", "--host", "0.0.0.0", "--port", "8000"]
